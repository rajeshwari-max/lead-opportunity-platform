__pycache__/
*.pyc
backend/data/
backend/logs/
backend/.venv/
frontend/node_modules/
frontend/dist/
.env

# Word lock files (created while a .docx is open) — never belong in the repo
~$*.docx
~$*.xlsx

# Live DevelopmentAid session — cookies for a signed-in account. backend/data/
# is already ignored, but the export writes wherever it is run from, and one of
# these reached the repo as an empty file. This repository is public, so a
# populated one would publish a working session to anyone who looked.
devaid_session.json
*devaid_session*.json
# Databases, wherever they land
*.db
*.db-wal
*.db-shm

# Team roster — real colleagues' addresses, and this repo is public.
backend/scripts/team.txt

# TypeScript incremental build cache. Tracking it means every `npm run build`
# on the server dirties the working tree, and the next `git pull` aborts with
# "local changes would be overwritten" — which silently left EC2 running old
# code while the deploy appeared to succeed.
*.tsbuildinfo

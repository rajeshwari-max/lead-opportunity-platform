# Copy to backend/.env and fill in. Never commit the real .env — it is
# gitignored, and these values are credentials.

# Email delivery -------------------------------------------------------------
LOP_SMTP_HOST=smtp.gmail.com
LOP_SMTP_PORT=587
LOP_SMTP_USER=
# Gmail App Password (16 characters), not your account password.
LOP_SMTP_PASSWORD=
LOP_SMTP_FROM_NAME=Lead Scanning Platform

# Daily digest ---------------------------------------------------------------
LOP_DIGEST_ENABLED=true
LOP_DIGEST_HOUR=9
LOP_DIGEST_MINUTE=0

# Approval links in digest emails --------------------------------------------
# Must be a URL your recipients can actually open — the Render URL in
# production. Localhost only works for mail read on this machine.
LOP_PUBLIC_BASE_URL=http://localhost:8000
# Where the dashboard UI is served. In development the API is on :8000 and Vite
# serves the UI on :5173, so a "view in dashboard" link built from the line
# above lands on the API and returns {"detail":"Not Found"}. In production both
# come from one host and this can be left blank.
LOP_DASHBOARD_URL=http://localhost:5173
# Signs the one-click approval links. Left blank, a random key is generated
# once and kept in backend/data/.approval_secret. Set it explicitly on any host
# without a persistent disk (Render free tier), or every deploy invalidates the
# approval links already sitting in people's inboxes.
LOP_APPROVAL_SECRET=

# Read-only mirror -----------------------------------------------------------
# true on the public cloud instance: disables scraping, scheduling and the
# dashboard's own Approve button. Signed email approval links still work.
LOP_READ_ONLY=false
